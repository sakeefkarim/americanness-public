//LG6.1//
version = 6.1
infile 'C:\path\to\americanness\data\latent gold data\main_posteriors.sav'


// =====================================================================
// "What Is Americanness?" -- Step-3 Supplementary: Party Leaners, Race Moderation
// Software: Latent GOLD 6.1 (Academic Version)
// Input: data/latent gold data/main_posteriors.sav.
// LG needs absolute paths: replace C:\path\to in infile.
// =====================================================================

// ==============================================================
// Model 3: Predicting Class Membership (Party Leaners)
// ==============================================================
model
title 'Class Membership (Party Leaners)';
options
   maxthreads=all;
   algorithm 
      tolerance=1e-08 emtolerance=0.01 emiterations=250 nriterations=50 ;
   startvalues
      seed=905 sets=16 tolerance=1e-05 iterations=50;
   bayes
      categorical=1 variances=1 latent=1 poisson=1;
   montecarlo
      seed=0 sets=0 replicates=500 tolerance=1e-08;
   quadrature  nodes=10;
   missing  excludeall;
   step3 proportional ml;
   output      
      parameters=first  marginaleffects betaopts=zwl standarderrors=robust profile=posterior
      probmeans=posterior 
      estimatedvalues=model reorderclasses;
variables
   caseid responseid;
   caseweight adj_weight;
   independent race nominal, party_lean nominal, generation_coarse nominal,
      daily_news nominal, university nominal, gender nominal, age, device nominal,
      religion_coarse nominal, region nominal;
   latent Cluster  nominal posterior = ( Class#1 Class#2 Class#3 Class#4
      Class#5 ) ;
equations
   Cluster <- 1 + race + party_lean + generation_coarse + daily_news + university + gender + age + device + religion_coarse + region
       + age * age;
end model


// ==============================================================
// Model 4: Distal Outcome (Pro-Immigration) + Race as Moderator
// ==============================================================
model
title 'Distal Outcome (w/ Race Interaction)';
options
   maxthreads=6;
   algorithm 
      tolerance=1e-08 emtolerance=0.01 emiterations=250 nriterations=50 ;
   startvalues
      seed=905 sets=16 tolerance=1e-05 iterations=50;
   bayes
      categorical=1 variances=1 latent=1 poisson=1;
   montecarlo
      seed=0 sets=0 replicates=500 tolerance=1e-08;
   quadrature  nodes=10;
   missing  excludeall;
   step3 proportional ml;
   output      
      parameters=first marginaleffects  betaopts=wl standarderrors=robust profile probmeans=posterior
      loadings estimatedvalues=model predictionstatistics=conditional reorderclasses;
variables
   caseid responseid;
   caseweight adj_weight;
   independent race nominal, party nominal, generation_coarse nominal,
      daily_news nominal, university nominal, gender nominal, age, device nominal,
      religion_coarse nominal, region nominal;
   dependent pro_immigration;
   latent Cluster  nominal posterior = ( Class#1 Class#2 Class#3 Class#4
      Class#5 ) ;
equations
   pro_immigration <- 1 + Cluster | race + party + race + generation_coarse + daily_news + university + age + gender + age * age + device + religion_coarse + region ;
end model


// ==============================================================
// Model 5: Predicting Class Membership + Race as Moderator
// ==============================================================
model
title 'Class Membership (w/ Race Interaction)';
options
   maxthreads=all;
   algorithm 
      tolerance=1e-08 emtolerance=0.01 emiterations=250 nriterations=50 ;
   startvalues
      seed=905 sets=16 tolerance=1e-05 iterations=50;
   bayes
      categorical=1 variances=1 latent=1 poisson=1;
   montecarlo
      seed=0 sets=0 replicates=500 tolerance=1e-08;
   quadrature  nodes=10;
   missing  excludeall;
   step3 proportional ml;
   output      
      parameters=first  marginaleffects betaopts=zwl standarderrors=robust profile=posterior
      probmeans=posterior 
      estimatedvalues=model reorderclasses;
variables
   caseid responseid;
   caseweight adj_weight;
   independent race nominal, party nominal, generation_coarse nominal,
      daily_news nominal, university nominal, gender nominal, age, device nominal,
      religion_coarse nominal, region nominal;
   latent Cluster  nominal posterior = ( Class#1 Class#2 Class#3 Class#4
      Class#5 ) ;
equations
   Cluster <- 1 + party | race + race + generation_coarse + daily_news + university + gender + age + device + religion_coarse + region
       + age * age;
end model
